{
    // Builds go through CMake so VS Code, CI and the command line all build
    // the same way. The cmake on PATH here is devkitPro's (for the DS), which
    // can't do native Windows builds, so these use the copy bundled with the
    // Visual Studio Build Tools.
    "version": "2.0.0",
    "options": {
        "env": {
            "PATH": "C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\CMake\\bin;C:\\Program Files (x86)\\Microsoft Visual Studio\\2022\\BuildTools\\Common7\\IDE\\CommonExtensions\\Microsoft\\CMake\\Ninja;C:\\msys64\\ucrt64\\bin;${env:PATH}"
        }
    },
    "tasks": [
        {
            "label": "Build plugin + tests (MSVC)",
            "type": "shell",
            "command": "cmake -S . -B build-msvc -G 'Visual Studio 17 2022' -A x64 -DGENISYS_BUILD_UI_SNAPSHOT=ON; cmake --build build-msvc --config Release --parallel",
            "options": { "cwd": "${workspaceFolder}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$msCompile"]
        },
        {
            "label": "Run plugin tests (MSVC build)",
            "type": "shell",
            "command": "ctest --test-dir build-msvc -C Release --output-on-failure",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "dependsOn": "Build plugin + tests (MSVC)",
            "problemMatcher": []
        },
        {
            "label": "Run Genisys standalone",
            "type": "shell",
            "command": "./build-msvc/plugin/Genisys_artefacts/Release/Standalone/Genisys.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Build plugin + tests (MSVC)",
            "problemMatcher": []
        },
        {
            "label": "Build desktop app + tests (GCC)",
            "type": "shell",
            "command": "cmake -S . -B build-gcc -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_C_COMPILER=gcc -DGENISYS_BUILD_DESKTOP=ON -DGENISYS_BUILD_PC_DEMO=ON; cmake --build build-gcc",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "Run tests (GCC build)",
            "type": "shell",
            "command": "ctest --test-dir build-gcc --output-on-failure",
            "options": { "cwd": "${workspaceFolder}" },
            "group": "test",
            "dependsOn": "Build desktop app + tests (GCC)",
            "problemMatcher": []
        },
        {
            "label": "Run desktop app",
            "type": "shell",
            "command": "./build-gcc/genisys_desktop.exe",
            "options": { "cwd": "${workspaceFolder}" },
            "dependsOn": "Build desktop app + tests (GCC)",
            "problemMatcher": []
        }
    ]
}
