{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build PC prototype",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=c11",
                "-Wall",
                "-Wextra",
                "-g",
                "-Isynth-core/include",
                "-Ithird_party",
                "pc/main.c",
                "synth-core/src/psg.c",
                "synth-core/src/ym2612.c",
                "-o",
                "build/synth.exe",
                "-lwinmm",
                "-lole32",
                "-lm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}
